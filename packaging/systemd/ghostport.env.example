# Copy to /etc/ghostport/ghostport.env and adjust for this host.
# Referenced by packaging/systemd/ghostport.service via EnvironmentFile.

# Network interface GhostPort attaches its ingress sensor to.
GHOSTPORT_INTERFACE=eth0

# Telemetry reporting interval.
GHOSTPORT_INTERVAL=10s

# Any additional GhostPort flags, space-separated. Scan detection is on by
# default; tune it here, e.g.:
#   GHOSTPORT_EXTRA_ARGS=--scan-vertical-threshold 15 --scan-window 20s
#
# To enable authenticated HTTPS event delivery, add the flags here, but put
# GHOSTPORT_DELIVERY_TOKEN itself in /etc/ghostport/delivery-token.env (see
# ghostport-delivery-token.env.example), not this file:
#   GHOSTPORT_EXTRA_ARGS=--deliver --deliver-endpoint https://collector.example.com/ghostport
GHOSTPORT_EXTRA_ARGS=
