# Copy to /etc/ghostport/delivery-token.env, set the token below, then:
#   chown root:ghostport /etc/ghostport/delivery-token.env
#   chmod 0640 /etc/ghostport/delivery-token.env
#
# Kept separate from ghostport.env so it can carry tighter permissions than
# the rest of the configuration. Only needed when GHOSTPORT_EXTRA_ARGS in
# ghostport.env includes --deliver.

GHOSTPORT_DELIVERY_TOKEN=replace-with-the-real-token
